<Project Sdk="Microsoft.NET.Sdk">
  <!-- Static check that every [HarmonyPatch] target in Hoard.dll still exists in the game
       assemblies with the signature the patch expects, and that every named patch parameter
       matches an original parameter. Run after a Valheim patch before launching the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
